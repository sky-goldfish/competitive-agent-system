APP_ENV=development
DATABASE_URL=sqlite:///./competitive_agent.db
LLM_PROVIDER=mock

# Ark LLM: set LLM_PROVIDER=ark
ARK_API_KEY=
ARK_ENDPOINT_ID=
ARK_MODEL=doubao-seed-2-0-lite
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenAI Chat Completions-compatible LLM: set LLM_PROVIDER=openai
# OPENAI_BASE_URL may point to OpenAI or any compatible third-party endpoint.
# For a local endpoint without authentication, set OPENAI_API_KEY to a placeholder value.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.2

SEARCH_PROVIDER=mock
BOCHA_API_KEY=
ENABLE_MOCK_SEARCH_FALLBACK=true
CORS_ORIGINS=http://localhost:5173
